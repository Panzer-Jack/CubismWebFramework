{
  "compilerOptions": {
    "target": "es6",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "rootDir": "./src",
    "module": "Node16",
    "moduleResolution": "Node16",
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "../Core/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
